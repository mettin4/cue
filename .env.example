# Circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Wallet set every Cue wallet is created inside, from createWalletSet
CIRCLE_WALLET_SET_ID=

# Treasury
# The wallet claims are paid out from, from scripts/test-circle.ts
TREASURY_WALLET_ID=
TREASURY_WALLET_ADDRESS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string (port 5432), used only by the migration script
SUPABASE_DB_URL=

# Resend
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hardening
# Shared service secret for the token authed API routes. Also signs the scoped
# session cookie that collecting money mints.
CUE_API_SECRET=
# Bearer token Vercel Cron sends to the scheduled payments runner. Set the same
# value in Vercel and it attaches it to the cron request automatically.
CRON_SECRET=
# Largest amount a single send may move, in dollars.
CUE_MAX_SEND_USDC=5
# Local only. Allows cancel windows shorter than the default. Leave unset in production.
CUE_ALLOW_SHORT_WINDOW=
# Where low pool alerts are emailed. Alerts are skipped when unset.
CUE_ALERT_EMAIL=
# Treasury guards (dollars). Defaults: floor 5, daily cap 50, alert 10.
CUE_TREASURY_FLOOR_USDC=
CUE_TREASURY_DAILY_CAP_USDC=
CUE_TREASURY_ALERT_USDC=
